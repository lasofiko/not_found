
# Copy to .env for local development. CORS origins use JSON list syntax.
BB_APP_NAME="FloCast"
BB_ENVIRONMENT=development
BB_API_PREFIX=/api/v1
BB_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
BB_LOG_LEVEL=INFO

# Vite server-side development proxy.
BB_DEV_BACKEND_URL=http://127.0.0.1:8000

# Compose-only settings; artifacts are mounted read-only, never baked into images.
BB_HTTP_PORT=8000
BB_MODELS_PATH=./models

# Optional isolated synthetic bundle; empty means /synthetic is disabled.
BB_SYNTHETIC_BUNDLE_PATH=

# LLM provider (server-only, optional). Leave empty to disable the assistant.
# For Yandex AI Studio use an OpenAI-compatible base URL and a model URI, e.g.:
# BB_LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# BB_LLM_MODEL=gpt://<folder_id>/<model_name>
# Client appends /chat/completions: use the API base, not the full endpoint.
BB_LLM_BASE_URL=
BB_LLM_API_KEY=
BB_LLM_MODEL=
BB_LLM_TIMEOUT_SECONDS=60
